  "cards": [
    {
      "dot": "emerald",
      "title": "单写字段纪律",
      "items": [
        "kit 自写 strategies/history;演化通道只写 strategy_adjustments",
        "无写竞争,演化贡献显式可审计",
        "压制闭环:下一 case 选策略即被减分(select_strategy ← adjustments)"
      ]
    },
    {
      "dot": "rose",
      "title": "门禁与回滚",
      "items": [
        "auto 类限 .v3.3_strategy_db.json 单文件 ≤12 行,apply 为人工操作",
        "上下文过期/空 diff 一律 REJECTED fail-closed;LEDGER + 备份链可 --rollback",
        "human 类提案进用户闸队列,永不自动批准任何东西"
      ]
    },
    {
      "dot": "orange",
      "title": "证据口径与蜂群",
      "items": [
        "连败窗 14 天、未来 ts >1h 容差排除,kit 后验与 observe 同口径",
        "L2 证据晋升:install/promote/demote 三门(内容禁闭+血统+沙盒试跑),canary 4 账 3 胜晋升 / 3 连败降级+墓碑",
        "策略耗尽→蜂群联网研究→模板映射出参数或新机制 human 提案;剧集回灌 repair_kb.jsonl 构成闭环"
      ]
    }
  ]
