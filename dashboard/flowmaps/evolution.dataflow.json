{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "演化层数据流:观测 → 提案 → 门禁 → 生效",
    "subtitle": "kit 账本 + pipeline 事件 + friction 软失败 → 提案(策略/蜂群) → 门禁/用户闸 → 生效",
    "locale": "zh-CN",
    "viewBox": [
      1080,
      880
    ],
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "observe-path",
        "label": "观测入账",
        "focus": [
          "cron",
          "kit-db",
          "decisions",
          "pipe-events",
          "observe",
          "atoms"
        ],
        "note": "cron 每 37 分钟驱动 observe(带间隔闸),把已结账结果、管线失效与软失败记入训练记忆。"
      },
      {
        "id": "proposal-gate",
        "label": "提案与门禁",
        "focus": [
          "streak",
          "swarm",
          "draft",
          "gate",
          "user-gates",
          "ledger"
        ],
        "note": "连败起草案过 apply_proposal 双层门禁;策略耗尽走蜂群联网研究,新机制提案进用户闸等人工。"
      },
      {
        "id": "effect-path",
        "label": "生效压制",
        "focus": [
          "adj",
          "select",
          "kit-db"
        ],
        "note": "只写 strategy_adjustments,select_strategy 打分减 penalty,单写字段无竞争。"
      }
    ]
  },
  "stages": [
    {
      "label": "数据源"
    },
    {
      "label": "观测"
    },
    {
      "label": "决策"
    },
    {
      "label": "门禁"
    },
    {
      "label": "生效"
    }
  ],
  "nodes": [
    {
      "id": "cron",
      "type": "cloud",
      "label": "cron */37min",
      "sublabel": "observe 间隔闸",
      "stage": 0,
      "row": 0,
      "tag": "驱动"
    },
    {
      "id": "pipe-events",
      "type": "database",
      "label": "事件流+friction",
      "sublabel": "pipeline/friction",
      "stage": 0,
      "row": 3,
      "tag": "CRITICAL/软失败"
    },
    {
      "id": "kit-db",
      "type": "database",
      "label": "策略库 db",
      "sublabel": ".v3.3 history/strategies",
      "stage": 0,
      "row": 2,
      "tag": "kit 自写"
    },
    {
      "id": "decisions",
      "type": "database",
      "label": "决策日志",
      "sublabel": "strategy_decisions.jsonl",
      "stage": 0,
      "row": 4,
      "tag": "只读"
    },
    {
      "id": "observe",
      "type": "backend",
      "label": "observe_kit()",
      "sublabel": "连败/连胜检测 14d 窗",
      "stage": 1,
      "row": 1,
      "tag": "演化层"
    },
    {
      "id": "atoms",
      "type": "database",
      "label": "训练记忆 atoms",
      "sublabel": "record_atom 幂等",
      "stage": 2,
      "row": 0,
      "tag": "refs 含 case_id"
    },
    {
      "id": "streak",
      "type": "backend",
      "label": "尾部连败 ≥2",
      "sublabel": "_tail_streak 同口径",
      "stage": 2,
      "row": 2,
      "tag": "检测"
    },
    {
      "id": "swarm",
      "type": "backend",
      "label": "蜂群研究",
      "sublabel": "联网研究→模板映射",
      "stage": 2,
      "row": 3,
      "tag": "策略耗尽触发"
    },
    {
      "id": "draft",
      "type": "messagebus",
      "label": "提案草稿",
      "sublabel": "proposal.md + diff.patch",
      "stage": 3,
      "row": 1,
      "tag": "auto 类"
    },
    {
      "id": "gate",
      "type": "security",
      "label": "apply_proposal 门禁",
      "sublabel": "白名单 · ≤12 行 · 人工",
      "stage": 3,
      "row": 3,
      "tag": "fail-closed"
    },
    {
      "id": "adj",
      "type": "database",
      "label": "adjustments 段",
      "sublabel": "penalty +0.15 / 封顶 0.6",
      "stage": 4,
      "row": 1,
      "tag": "演化唯一写入"
    },
    {
      "id": "select",
      "type": "backend",
      "label": "select_strategy",
      "sublabel": "打分减 penalty",
      "stage": 4,
      "row": 3,
      "tag": "压制生效"
    },
    {
      "id": "ledger",
      "type": "database",
      "label": "LEDGER + 备份",
      "sublabel": "审计留痕 · --rollback",
      "stage": 4,
      "row": 4,
      "tag": "可回滚"
    },
    {
      "id": "user-gates",
      "type": "security",
      "label": "用户闸队列",
      "sublabel": "human 提案·等人工",
      "stage": 3,
      "row": 4,
      "tag": "永不自动批"
    }
  ],
