{
  "name": "dsh-remote-world",
  "version": "0.0.1",
  "description": "把 dsh 的执行世界（ctx.fs / ctx.subprocess / ctx.sandbox 三个接缝）指向用户机器上的 mdshell：云端脑子、本地算力，壳子零 IP。",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./fs": "./lib/fs.js",
    "./subprocess": "./lib/subprocess.js",
    "./sandbox": "./lib/sandbox.js",
    "./directorypicker": "./lib/directorypicker.js",
    "./protocol": "./lib/protocol.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
