# 小规模先行验证探针(500 原子):dt 经 -var dt 传入;dt 过大将真实失稳(lost atoms)
variable dtv index ${dt}
units real
boundary p p p
atom_style atomic
lattice fcc 5.31
region box block 0 5 0 5 0 5
create_box 1 box
create_atoms 1 box
mass 1 39.948
pair_style lj/cut 8.5
pair_coeff 1 1 0.2381 3.405
neighbor 2.0 bin
velocity all create 90.0 84845 mom yes rot no dist gaussian
timestep ${dtv}
fix 1 all nvt temp 90.0 90.0 100.0
thermo 1000
thermo_style custom step temp pe etotal press density
thermo_modify format float %.10g
run 10000
print "EVLIVE_PROBE_TEND $(temp)"
print "EVLIVE_DONE ok"
